{
  "name": "dsh-skill-manager",
  "version": "0.1.0",
  "description": "Session view listing every skill with an enable checkbox; unchecked skills leave the model catalog and are refused by the skill tool.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "zh.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "skills",
    "skill-manager"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ugg-ki/dsh-skill-manager.git"
  },
  "homepage": "https://github.com/ugg-ki/dsh-skill-manager#readme",
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
